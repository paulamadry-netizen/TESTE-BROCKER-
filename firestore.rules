rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    // Vérifier si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifier si l'utilisateur est admin
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Vérifier si l'utilisateur accède à ses propres données
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Lecture: uniquement ses propres données OU admin
      allow read: if isOwner(userId) || isAdmin();

      // Autoriser uniquement la MAJ de activeAccountId depuis le client (multi-comptes)
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['activeAccountId']);

      // Tout le reste: bloqué côté client
      allow create, delete: if false;

      // Sous-collection accounts: lecture autorisée pour le propriétaire/admin
      match /accounts/{accountId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ==========================================
    // TRADES COLLECTION
    // ==========================================
    match /trades/{tradeId} {
      // Lecture: uniquement ses propres trades OU admin
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Écriture: JAMAIS depuis le client (uniquement via Cloud Functions Admin SDK)
      allow create, update: if false;
      
      // Suppression: non autorisée côté client
      allow delete: if false;
    }

    // ==========================================
    // ORDERS COLLECTION (ordres limites)
    // ==========================================
    match /orders/{orderId} {
      // Lecture: uniquement ses propres ordres OU admin
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Écriture: JAMAIS depuis le client (uniquement via Cloud Functions Admin SDK)
      allow create, update: if false;
      
      // Suppression: non autorisée côté client
      allow delete: if false;
    }

    // ==========================================
    // AUDIT LOGS (lecture seule pour admin)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;  // Uniquement via Cloud Functions
    }

    // ==========================================
    // PAYOUT REQUESTS
    // ==========================================
    match /payout_requests/{requestId} {
      // Lecture: ses propres demandes OU admin
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Écriture: JAMAIS depuis le client
      allow write: if false;
    }

    // ==========================================
    // PRICE SNAPSHOTS (audit des prix)
    // ==========================================
    match /price_snapshots/{snapshotId} {
      allow read: if isAuthenticated();  // Tous peuvent lire
      allow write: if false;  // Uniquement Cloud Functions
    }

    // ==========================================
    // DÉFAUT: TOUT BLOQUER
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
